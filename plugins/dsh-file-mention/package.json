{
  "name": "dsh-file-mention",
  "version": "0.1.0",
  "description": "Dual-face plugin: '@file' mentions in the composer — candidate menu sourced from the host workspace file tree, plain-text reference insert (@plan.md), literal model serialization (the agent reads the file with its own tools).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "bash scripts/build.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.0"
  },
  "license": "MIT"
}
