{
  "name": "dsh-desktop",
  "version": "1.0.0",
  "description": "Electron desktop shell for DeepSeek Harness web UI (boots dsh web profile: dsh-base + dsh-web-app plugin stack)",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "make:icon": "node scripts/make-icon.js",
    "build:win": "node scripts/ensure-vendor-node.js && electron-builder --win",
    "build:win:nsis": "node scripts/ensure-vendor-node.js && electron-builder --win nsis",
    "build:win:zip": "node scripts/ensure-vendor-node.js && electron-builder --win zip",
    "build:mac": "node scripts/ensure-vendor-node.js && electron-builder --mac",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "png2icons": "^2.0.1"
  }
}
