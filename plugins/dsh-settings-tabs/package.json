{
  "name": "dsh-settings-tabs",
  "version": "0.1.0",
  "description": "Dual-face plugin: adds a Skills tab and an MCP tab to the Web Settings Plugins section — skill catalog from the host skill registry, MCP server list from the Cordis Loader entries.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "bash scripts/build.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.0",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.0"
  },
  "license": "MIT"
}
